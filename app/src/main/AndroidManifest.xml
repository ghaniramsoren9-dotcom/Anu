        <service android:name=".ZoyaOverlayService" android:exported="false" android:stopWithTask="false" />
        <service android:name=".ZoyaNotificationListenerService" android:exported="true" android:label="Anu Notification Access" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"><intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter></service>
