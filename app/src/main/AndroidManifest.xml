    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="com.google.android.youtube" /><package android:name="com.whatsapp" /><package android:name="com.instagram.android" /><package android:name="com.facebook.katana" /><package android:name="com.android.chrome" /><package android:name="com.google.android.apps.maps" /><package android:name="com.spotify.music" />
    </queries>
    <application android:name=".AnuApplication" android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.Zoya">
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name" android:theme="@style/Theme.Zoya" android:supportsPictureInPicture="true" android:resizeableActivity="true" android:windowSoftInputMode="adjustResize"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>
